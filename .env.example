# Database
DATABASE_URL=postgresql://qjhy:qjhy_dev_password@localhost:5432/qjhy

# DingTalk OAuth (Phase 1 配置真实值)
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_CORP_ID=
# 企业内部应用 AgentId，用于向员工发送绩效节点工作通知
DINGTALK_AGENT_ID=
# 候选人页“从钉钉更新”使用的 DWS CLI 与来源表（本地已登录 dws 后可直接使用）
DINGTALK_CLI_PATH=dws
DINGTALK_RECRUITMENT_SHEET_URL=https://alidocs.dingtalk.com/i/nodes/X6GRezwJlYBBZd3LurM9aqmN8dqbropQ?utm_scene=person_space
DINGTALK_RECRUITMENT_SHEET_ID=st-da2f6966-43922

# DingTalk Bot Webhook (报错通知，关键词 "报错"才能推送)
DINGTALK_BOT_WEBHOOK=
PROCUREMENT_DINGTALK_WEBHOOK=
PLACEMENT_ALERT_DINGTALK_WEBHOOK=

# 剪辑加急专用机器人 webhook（不配置则用 DINGTALK_BOT_WEBHOOK 兜底）
EDITING_DINGTALK_WEBHOOK=

# Auth
AUTH_SECRET=
EMERGENCY_LOGIN_PASSWORD=

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mini Program local development only. Production authentication will use wx.login.
# Set both values when running the WeChat DevTools against the local API.
MINIPROGRAM_DEV_USER_ID=

# Puppeteer (Phase 2)
PUPPETEER_HEADLESS=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# 默认基地（Phase 2 仅支持 cs）
DOUYIN_DEFAULT_BASECAMP=cs

# Portrait Core CID（T16 smoke test 时用 Chrome DevTools 抓真实 cid 填入）
DOUYIN_PORTRAIT_CORE_CID=

# Editing NAS（本地开发用临时目录，Docker 生产挂载 NFS）
EDITING_NAS_PATH=./tmp/editing-nas
COURSE_NAS_PATH=./tmp/course-nas
# Shared project images and other small binary assets (NAS-mounted in production).
PROJECT_ASSETS_PATH=
