# Database
DATABASE_URL=postgresql://qjhy:qjhy_dev_password@localhost:5432/qjhy

# DingTalk OAuth (Phase 1 配置真实值)
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_CORP_ID=

# DingTalk Bot Webhook (报错通知，关键词 "报错"才能推送)
DINGTALK_BOT_WEBHOOK=

# Auth
AUTH_SECRET=
EMERGENCY_LOGIN_PASSWORD=

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Puppeteer (Phase 2)
PUPPETEER_HEADLESS=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# 默认基地（Phase 2 仅支持 cs）
DOUYIN_DEFAULT_BASECAMP=cs
