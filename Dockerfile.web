# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

FROM base AS deps
WORKDIR /app
ENV HUSKY=0
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Build-time placeholders so env validation passes during page-data collection.
# Real values are injected at runtime via docker-compose environment.
ENV DATABASE_URL=postgresql://build:build@localhost:5432/build
ENV AUTH_SECRET=build_time_placeholder_secret_value
ENV EMERGENCY_LOGIN_PASSWORD=build_time_placeholder_password
# Webpack is the stable production bundler for this workspace. Turbopack can
# stall indefinitely during the amd64 image build on the ARM development host.
RUN ./node_modules/.bin/next build --webpack && node scripts/verify-web-release-routes.mjs

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV COURSE_NAS_PATH=/mnt/miracle-courses
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/scripts/http-request-timeout.mjs ./http-request-timeout.mjs
# Production NAS media directories are root-owned (0700). Keep the image default
# aligned with docker-compose so direct container recreation cannot break media I/O.
USER root
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV HTTP_REQUEST_TIMEOUT_MS=600000
ENV NODE_OPTIONS="--import=/app/http-request-timeout.mjs"
CMD ["node", "server.js"]
