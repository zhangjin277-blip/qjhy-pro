# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS base
# chromium + 依赖（Puppeteer 无头浏览器爬虫）
RUN apk add --no-cache \
    libc6-compat \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
# 预装 pnpm 进 image，避免 runtime 现拉 npmjs.org/pnpm.tgz 卡启动
RUN corepack enable && corepack prepare pnpm@11.1.1 --activate

FROM base AS deps
WORKDIR /app
ENV HUSKY=0
COPY package.json pnpm-lock.yaml ./
# 国内 npm registry，避免 npmjs.org 超时
RUN pnpm config set registry https://registry.npmmirror.com && \
    pnpm install --frozen-lockfile --ignore-scripts

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
# Puppeteer: 使用系统安装的 chromium（alpine 包），跳过内置 chromium 下载
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV NODE_OPTIONS=--conditions=react-server
COPY --from=deps /app/node_modules ./node_modules
COPY . .
CMD ["pnpm", "exec", "tsx", "src/worker/index.ts"]
